# Response headers on heatstitch.app (Cloudflare reads this file, it is not served).
# Built files carry a hash in their name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# A browser that once reached the site over https stays on https (the Worker sends the same).
/*
  Strict-Transport-Security: max-age=31536000
