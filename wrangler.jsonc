// heatstitch.app: the built site as static assets of a Worker (cloudflare/worker.js), deployed by
// .github/workflows/release.yml when a release is published. Pull request previews are versions with an
// alias, at https://pr-N-heatstitch.<account>.workers.dev; they never reach heatstitch.app. The beta
// (env beta below) is a Worker of its own at beta.heatstitch.app, deployed from develop by deploy.yml.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heatstitch",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every file at exactly its path (docs.html stays docs.html), as on GitHub Pages; the Worker adds index.html.
    "html_handling": "none",
    "not_found_handling": "none",
    // A request a file matches (docs.html, sitemap.xml, ...) is answered by that file; the Worker never runs for it.
    "run_worker_first": false
  },
  "routes": [{ "pattern": "heatstitch.app", "custom_domain": true }],
  // The site is only at heatstitch.app; workers.dev only carries the previews.
  "workers_dev": false,
  "preview_urls": true,
  "env": {
    // beta.heatstitch.app: develop after every merge. The same Worker and assets, its own address and so
    // its own storage; no previews (those stay versions of the main Worker).
    "beta": {
      "name": "heatstitch-beta",
      "routes": [{ "pattern": "beta.heatstitch.app", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
