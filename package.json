{
  "name": "heatstitch",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/wasm.mjs",
    "test": "vitest run",
    "test:timings": "node scripts/test-timings.mjs",
    "pretypecheck": "node scripts/wasm.mjs",
    "typecheck": "tsc --noEmit",
    "wasm": "wasm-pack build core --target web --out-dir ../src/wasm/pkg --no-pack --release"
  },
  "devDependencies": {
    "highs": "^1.15.3",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
